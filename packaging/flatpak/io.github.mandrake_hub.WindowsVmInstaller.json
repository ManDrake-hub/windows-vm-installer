{
    "app-id": "io.github.mandrake_hub.WindowsVmInstaller",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "windows-vm-installer-flatpak",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=/dev",
        "--filesystem=/sys/firmware/efi",
        "--talk-name=org.freedesktop.PolicyKit1",
        "--system-talk-name=org.freedesktop.PolicyKit1"
    ],
    "modules": [
        {
            "name": "libefi",
            "url": "https://github.com/rhboot/libefi/releases/download/efi-3.0.9/libefi-3.0.9.tar.gz",
            "buildsystem": "autotools",
            "config-opts": [
                "--prefix=/app"
            ]
        },
        {
            "name": "efibootmgr",
            "url": "https://github.com/rhboot/efibootmgr/releases/download/18/efibootmgr-18.tar.gz",
            "buildsystem": "autotools",
            "config-opts": [
                "--prefix=/app"
            ]
        },
        {
            "name": "libtpms",
            "url": "https://github.com/stefanberger/libtpms/releases/download/v0.10/libtpms-0.10.tar.gz",
            "buildsystem": "autotools",
            "config-opts": [
                "--prefix=/app"
            ]
        },
        {
            "name": "swtpm",
            "url": "https://github.com/stefanberger/swtpm/releases/download/v0.10/swtpm-0.10.tar.gz",
            "buildsystem": "autotools",
            "config-opts": [
                "--prefix=/app"
            ]
        },
        {
            "name": "windows-vm-installer",
            "buildsystem": "simple",
            "sources": [
                { "type": "dir", "path": "../.." }
            ],
            "build-commands": [
                "find . -name __pycache__ -type d -exec rm -r {} +",
                "python3 -m pip wheel --no-deps --no-build-isolation -w /tmp/wheels .",
                "python3 -m pip install --no-deps --no-index --prefix=/app /tmp/wheels/*.whl",
                "printf '#!/bin/sh\\nexec windows-vm-installer gui \"$@\"\\n' > /app/bin/windows-vm-installer-flatpak",
                "chmod 755 /app/bin/windows-vm-installer-flatpak",
                "mkdir -p /app/share/applications",
                "sed 's|^Exec=.*|Exec=windows-vm-installer-flatpak|' data/io.github.mandrake_hub.WindowsVmInstaller.desktop > /app/share/applications/io.github.mandrake_hub.WindowsVmInstaller.desktop"
            ]
        }
    ]
}
